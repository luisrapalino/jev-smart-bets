# Base de datos (Neon PostgreSQL Serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Proveedor de cuotas deportivas
ODDS_API_KEY=

# SDK de Jev (TypeSafe AI). Consigue tu key en https://typesafe.ai (early access).
# Sin configurar, /api/jev cae a una respuesta simulada.
TYPESAFE_API_KEY=

# IDs de afiliado por operador (ver lib/affiliates/operators.ts).
# Sin configurar, los enlaces apuntan a la home del operador sin tag.
AFFILIATE_ID_BET365=
AFFILIATE_ID_RUSHBET=
AFFILIATE_ID_WPLAY=

# Cache compartido de cuotas (Upstash Redis / Vercel Marketplace Redis).
# Sin configurar, cae a un cache en memoria del proceso (ver lib/cache/kv.ts).
KV_REST_API_URL=
KV_REST_API_TOKEN=
