# Todas las variables de este archivo son OPCIONALES: sin ninguna, el
# proyecto arranca en modo demo con datos simulados y todo funciona.
# Cada integracion degrada por separado.

# Base de datos (Neon PostgreSQL Serverless).
# Sin configurar, el historial vive en memoria del proceso y se pierde
# al reiniciar (ver lib/db/repository.ts). Con ella: pnpm db:push
DATABASE_URL=

# Proveedor de cuotas deportivas (https://the-odds-api.com).
# Sin configurar, el tablero usa partidos simulados.
ODDS_API_KEY=

# SDK de Jev (TypeSafe AI). Consigue tu key en https://typesafe.ai (early access).
# Sin configurar, /api/jev cae a una respuesta simulada.
TYPESAFE_API_KEY=

# IDs de afiliado por operador (ver lib/affiliates/operators.ts).
# Sin configurar, los enlaces apuntan a la seccion de futbol del operador sin tag.
AFFILIATE_ID_BET365=
AFFILIATE_ID_RUSHBET=
AFFILIATE_ID_WPLAY=

# Envio de email para el login por magic link (https://resend.com).
# Sin configurar (y con DATABASE_URL puesta), el link no se manda: se
# loguea en la consola del server, para poder probar el login sin
# credenciales de email. Sin DATABASE_URL, no hay cuentas: son el unico
# caso de este archivo que no tiene modo demo, porque su razon de ser es
# persistir identidad entre dispositivos.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Cache compartido de cuotas (Upstash Redis / Vercel Marketplace Redis).
# Sin configurar, cae a un cache en memoria del proceso (ver lib/cache/kv.ts).
KV_REST_API_URL=
KV_REST_API_TOKEN=
